#usda 1.0
(
    defaultPrim = "wood_block_001"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "wood_block_001" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "SemanticsLabelsAPI:class", "MaterialBindingAPI"]
    kind = "component"
)
{
    rel material:binding:physics = </wood_block_001/physics_materials/surface>
    point3f physics:centerOfMass = (0, 1.8381791e-19, 0.015)
    float3 physics:diagonalInertia = (0.0000108, 0.00001944, 0.000022464)
    bool physics:kinematicEnabled = 0
    float physics:mass = 0.05184
    quatf physics:principalAxes = (1, 0, 0, 0)
    bool physics:rigidBodyEnabled = 1
    token[] semantics:labels:class = ["wood_block"]

    def "physics_materials"
    {
        def Material "surface" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.45
            float physics:restitution = 0.08
            float physics:staticFriction = 0.55
        }
    }

    def Scope "colliders"
    {
        def Mesh "body" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-0.03, -0.02, 0), (0.03, 0.02, 0.03)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [3, 2, 1, 0, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7, 4, 5, 6, 7]
            rel material:binding:physics = </wood_block_001/physics_materials/surface>
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
            point3f[] points = [(-0.03, -0.02, 0), (0.03, -0.02, 0), (0.03, 0.02, 0), (-0.03, 0.02, 0), (-0.03, -0.02, 0.03), (0.03, -0.02, 0.03), (0.03, 0.02, 0.03), (-0.03, 0.02, 0.03)]
            uniform token purpose = "guide"
            uniform token subdivisionScheme = "none"
            token visibility = "invisible"
        }
    }
}

